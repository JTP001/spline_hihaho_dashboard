# API Key of the client using this instance goes here
API_KEY="YOUR_API_KEY"

# Your backend address goes here (used in backend settings.py). Just the domain, no http://
DJANGO_ALLOWED_HOSTS=your_backend_address

# Deployed database access link goes here, locally can be done with docker postgres
DATABASE_URL=your_db_link

# Your backend address goes here (used in frontend, injected via env.js)
REACT_APP_API_URL=http://your_backend_address

# Your frontend address goes here, must start with http://
CORS_ALLOWED_ORIGINS=http://your_frontend_address

# Superuser username for admin access
DJANGO_SUPERUSER_USERNAME=your_superuser_username

# Superuser password for admin access
DJANGO_SUPERUSER_PASSWORD=your_superuser_password

# Superuser email for admin access
DJANGO_SUPERUSER_EMAIL=your_superuser_email@gmail.com

# Set this to False or delete it entirely for deployed versions, set it to True for local testing with Django built-in sqlite
USE_SQLITE=True
